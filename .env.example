# Banco de dados PostgreSQL
POSTGRES_DB=contabilidade
POSTGRES_USER=contabilidade
POSTGRES_PASSWORD=contabilidade_dev

# Cache Redis
REDIS_URL=redis://localhost:6379/0

# Certificado digital (producao apenas)
# Deixar vazio para usar mock SEFAZ
CERTIFICADO_A1_PATH=
CERTIFICADO_A1_SENHA=
CNPJ_CONSULTADO=

# Ambiente SEFAZ
# homologacao: ambiente de testes oficial da Receita
# producao: ambiente real (exige certificado valido)
SEFAZ_AMBIENTE=homologacao

# Mock SEFAZ local
# true: usa mock local (sem certificado, sem CNPJ)
# false: usa SEFAZ real (exige certificado e CNPJ)
MOCK_SEFAZ=true
SEFAZ_MOCK_URL=http://localhost:9000

# Rate limit SEFAZ (maximo 3 consultas/segundo)
SEFAZ_RATE_LIMIT=3

# Tolerancias de reconciliacao
TOLERANCIA_PRECO_PERCENT=2.0
TOLERANCIA_QTD_PERCENT=5.0
TOLERANCIA_DATA_DIAS=3

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000

# Logging
LOG_LEVEL=INFO
